            m_BoolArgument: 0
          m_CallState: 2
    BG: {fileID: -3384968524457798453, guid: 0a600e15c1afb2046a0b31923ea8c50b, type: 3}
  - speakerName: You
    sentence: Roger that, commander!
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
