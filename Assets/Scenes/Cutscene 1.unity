  nameText: {fileID: 782994398}
  dialogueText: {fileID: 588626895}
  scriptLines:
  - speakerName: Commander Idov
    sentence: Morning, rookie. Still buzzing from yesterday?
    onLineStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 888597894}
          m_TargetAssemblyTypeName: 
          m_MethodName: 
          m_Mode: 0
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    BG: {fileID: -6729120415704564605, guid: 6f2fec99bbbab9a4e81e4612d933e121, type: 3}
  - speakerName: Commander Idov
    sentence: "Enjoy the view while it\u2019s quiet. It never stays that way for
      long"
    onLineStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 888597894}
          m_TargetAssemblyTypeName: 
          m_MethodName: 
          m_Mode: 0
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    BG: {fileID: -6729120415704564605, guid: 6f2fec99bbbab9a4e81e4612d933e121, type: 3}
  - speakerName: You
    sentence: What the ?! Again?!
    onLineStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 888597898}
          m_TargetAssemblyTypeName: CutsceneManager, Assembly-CSharp
          m_MethodName: BGanimation
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    BG: {fileID: -4443887214759112852, guid: 1660cdd0002670c4d9305cde5f2ef8f0, type: 3}
  - speakerName: Commander Idov
    sentence: "Looks like it's the mothership this time. We'll need our turrets in
      tip-top shape. You\u2019re flying point this time. Let\u2019s move!"
    onLineStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 888597898}
          m_TargetAssemblyTypeName: CutsceneManager, Assembly-CSharp
          m_MethodName: SwitchBG
